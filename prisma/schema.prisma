generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Smoke test: entidad mínima para validar el stack de punta a punta.
model Note {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notes")
}

// Acceso beta: códigos de invitación (opción 1, sin cuentas de usuario).
model InviteCode {
  code      String   @id @db.VarChar(32)
  label     String?  @db.VarChar(120)
  maxUses   Int      @default(50)
  uses      Int      @default(0)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("invite_codes")
}
