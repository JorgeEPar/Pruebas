# Postgres local (docker-compose.yml). Copiar a .env (no comitear).
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Se completan al elegir negocio / integrar servicios:
# BETTER_AUTH_SECRET=""
# BREVO_API_KEY=""
# S3_ENDPOINT="" S3_BUCKET="" S3_ACCESS_KEY="" S3_SECRET_KEY=""

# IA (MVP ideas). Key gratis en https://aistudio.google.com/apikey — SOLO servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=""
# Modelo a usar (default: gemini-2.5-flash). Cambiar sin tocar código.
AI_MODEL="gemini-2.5-flash"
